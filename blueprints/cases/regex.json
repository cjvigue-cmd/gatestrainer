{
  "about": "A 24-hour time HH:MM, validated whole: hours 00-23, minutes 00-59.",
  "inputs": {
    "matches": "00:00\n09:30\n13:05\n19:59\n23:59\n",
    "rejects": "24:00\n9:30\n12:60\n12:5\n23:59:00\n 12:00\n1200\n",
    "mode": "full"
  },
  "good": [
    "([01]\\d|2[0-3]):[0-5]\\d\n",
    "(?:[01][0-9]|2[0-3]):(?:[0-5][0-9])"
  ],
  "bad": [
    "\\d{2}:\\d{2}",
    "([01]?\\d|2[0-3]):[0-5]\\d",
    "([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?",
    "/([01]\\d|2[0-3]):[0-5]\\d/",
    "Here is the pattern:\n([01]\\d|2[0-3]):[0-5]\\d"
  ]
}
